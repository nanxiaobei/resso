{
  "name": "resso",
  "version": "0.26.0",
  "description": "The simplest React state manager",
  "license": "MIT",
  "keywords": [
    "react",
    "hooks",
    "flux",
    "redux",
    "store",
    "state",
    "resso"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanxiaobei/resso.git"
  },
  "author": "nanxiaobei <nanxiaobei@gmail.com>",
  "homepage": "https://github.com/nanxiaobei/resso",
  "bugs": "https://github.com/nanxiaobei/resso/issues",
  "types": "./dist/resso.d.ts",
  "module": "./dist/resso.esm.js",
  "main": "./dist/resso.cjs.js",
  "exports": {
    ".": {
      "types": "./dist/resso.d.ts",
      "require": "./dist/resso.cjs.js",
      "import": "./dist/resso.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "rm -rf dist coverage && rollup -c --bundleConfigAsCjs --configPlugin @rollup/plugin-typescript"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "use-sync-external-store": "^1.7.0"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.6",
    "rollup-plugin-dts": "^6.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
